# Production build (e.g. Vercel): full PocketBase URL — required for the deployed SPA to reach your API.
# VITE_POCKETBASE_URL=https://blb-pocketbase.fly.dev

# Local `npm run dev` only: where Vite proxies `/hcgi/platform` (default is Fly production).
# Use local PocketBase instead:
# VITE_POCKETBASE_PROXY_TARGET=http://127.0.0.1:8090
